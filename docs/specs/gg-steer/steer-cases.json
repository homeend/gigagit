{
  "about": "Replay corpus for a steering consumer (spec 2026-10-15-gg-steer-ide-consumer §7). `sync: true` cases are refusals a consumer answers without touching git; gg's TUI is tested against them. `sync: false` cases carry the TUI's exact landing prose (which the IDE repeats); the TUI answers them asynchronously, so its test skips them. `tui_only` cases are the TUI's (the IDE has a twin marked `ide_only`). `error_prefix` matches the start of `error`; `error`/`detail` match exactly.",
  "files": {
    "a.go": "package a\n\nfunc gate() {}\n"
  },
  "cases": [
    {
      "name": "unknown verb",
      "sync": true,
      "command": {
        "id": "c-1",
        "cmd": "dance",
        "wait": true
      },
      "reply": {
        "ok": false,
        "error": "unknown command \"dance\""
      }
    },
    {
      "name": "target state nobody knows",
      "sync": true,
      "command": {
        "id": "c-2",
        "cmd": "navigate",
        "file": "a.go",
        "target": {
          "state": "shelf"
        },
        "wait": true
      },
      "reply": {
        "ok": false,
        "error_prefix": "unknown target state"
      }
    },
    {
      "name": "line side nobody knows",
      "sync": true,
      "command": {
        "id": "c-3",
        "cmd": "navigate",
        "file": "a.go",
        "line": {
          "side": "left",
          "no": 1
        },
        "wait": true
      },
      "reply": {
        "ok": false,
        "error_prefix": "unknown side"
      }
    },
    {
      "name": "another worktree",
