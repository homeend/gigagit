# Normalize line endings. The repository stores text as LF; the working tree
# gets LF for source files on every platform (this project targets Windows +
# Linux + macOS, and the working copy may live on a Windows-mounted drive).
* text=auto eol=lf

# Go tooling (gofmt) requires LF.
*.go    text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf
*.sh    text eol=lf
*.md    text eol=lf

# Windows batch scripts conventionally use CRLF.
*.cmd   text eol=crlf
*.bat   text eol=crlf
